diff -ruN --no-dereference a/quickshell/macos/shell.qml b/quickshell/macos/shell.qml
--- a/quickshell/macos/shell.qml	2026-11-23 21:25:27.379606466 +0100
+++ b/quickshell/macos/shell.qml	2026-11-23 22:09:14.209396336 +0100
@@ -19,13 +19,35 @@
 
 ShellRoot {
     id: root
+    // Achraf: size of the menu bar + Dock per monitor (1 = original revo size)
+    property real mainScreenScale: 0.75     // square monitor (VGA-1)
+    property real secondScreenScale: 0.72   // wide monitor (HDMI-A-2)
 
-    TopBar { id: topBar }
+    TopBar { id: topBar; uiScale: root.mainScreenScale }
+    // Achraf: menu bar on every other monitor too (the main one keeps id topBar)
+    Variants {
+        model: Quickshell.screens.filter((s, i) => i > 0)
+        TopBar {
+            required property var modelData
+            screen: modelData
+            uiScale: root.secondScreenScale
+        }
+    }
     Loader { active: Config.spotlight.enable; sourceComponent: Spotlight {} }
     Loader { active: Config.launchpad.enable; sourceComponent: Launcher {} }
-    Loader { active: Config.dock.enable; sourceComponent: Dock {} }
+    Loader { active: Config.dock.enable; sourceComponent: Dock { uiScale: root.mainScreenScale } }
+    // Achraf: Dock on every other monitor too
+    Variants {
+        model: Config.dock.enable ? Quickshell.screens.filter((s, i) => i > 0) : []
+        Dock {
+            required property var modelData
+            targetScreen: modelData
+            isPrimary: false
+            uiScale: root.secondScreenScale
+        }
+    }
     Genie {}
-    AboutWindow { parentWindow: topBar }
+    AboutWindow {}
     NotificationPopup {}
     Session {}
     ConfirmDialog {}
